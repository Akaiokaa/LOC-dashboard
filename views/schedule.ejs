                <% ["2022-23","2023-24","2024-25","2025-26","2026-27"].forEach(year => { %>
                    <% 
                        const match = assessments.find(a => a.program_name === "Visual Arts (Photography/Art)" && a.academic_year === year);
                    %>
                    <% if (match) { %>
