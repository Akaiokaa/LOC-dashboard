                <td class="left">Dance</td>
                <% ["2022-23","2023-24","2024-25","2025-26","2026-27"].forEach(year => { %>
                    <% 
                        const match = assessments.find(a => a.program_name === "Dance" && a.academic_year === year);
                    %>
                    <% if (match) { %>
                        <td value="<%= year %>">X</td>
                    <% } else { %>
