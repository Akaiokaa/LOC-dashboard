<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Summary</title>
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <!-- Buttons JS -->
    <script src="https://cdn.datatables.net/buttons/3.0.1/js/dataTables.buttons.min.js"></script>
    <!-- CSV Export -->
    <script src="https://cdn.datatables.net/buttons/3.0.1/js/buttons.html5.min.js"></script>
    <!-- CSV ICON -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/styles/home.css" />
    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css"
    />
    <link rel="icon" href="/images/GRC_logo.svg" />
  </head>

  <body>
    <%- include('partials/header') %>
    <main>
      <div id="main-aside"><%- include('partials/aside') %></div>
      <div>
        <table id="summary-table">
          <thead>
            <th>Division</th>
            <th>Division Chair</th>
            <th>Dean</th>
            <th>LOC Rep</th>
            <th>PEN Contact</th>
            <th>Payee(s)</th>
            <th>Amount</th>
            <th>Has been paid</th>
            <th>Notes</th>
          </thead>
          <tbody>
            <% newRecords.forEach(record => { %>
            <tr>
              <td><%= record.division_name %></td>
              <td><%= record.chair %></td>
              <td><%= record.dean %></td>
              <td><%= record.loc_rep %></td>
              <td><%= record.pen_contact %></td>
              <td><%= record.payees %></td>
              <td><%= record.total_amount %></td>
              <td><%= record.has_been_paid %></td>
              <td><%= record.notes %></td>
            </tr>
            <% });%>
          </tbody>
        </table>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
  <script defer>
    let table = new DataTable("#summary-table", {
      layout: {
        topStart: {
          buttons: [{
          extend: "csv",
          text: '<i class="fas fa-file-download"></i> CSV',
        }],
        },
      },
    });
  </script>
</html>